<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicação para o Winhost: self-contained win-x64 (leva o runtime .NET 10, não depende do servidor).
  Uso:  dotnet publish src/Bezix.Facturacao.Web -p:PublishProfile=Winhost
  Resultado em artifacts/publish/winhost, para enviar por FTP ou Web Deploy (ver docs/instalacao-winhost.md).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishUrl>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\winhost\</PublishUrl>
    <PublishDir>$(PublishUrl)</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- ReadyToRun duplicaria o tamanho (~245 MB); o arranque a frio é coberto pelo aquecimento do Scheduled Task. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- App_Data guarda uploads, PDFs emitidos (retenção legal de 10 anos) e logs: nunca substituir nem apagar no deploy. -->
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
  </PropertyGroup>
</Project>
