@model Bezix.Facturacao.Web.Pages.Artigos.IndexModel
@using Bezix.Facturacao.Domain.Artigos
@{
    var gerir = User.TemPermissao(Permissoes.Artigos.Gerir);
}
@if (Model.Resultado.Total == 0)
{
    <div class="vazio">
        @if (Model.Filtrado)
        {
            <i class="ph ph-magnifying-glass"></i>
            <p class="mb-0">Nenhum artigo corresponde à pesquisa.</p>
        }
        else
        {
            <i class="ph ph-package"></i>
            <p>Ainda não há artigos. Crie os produtos e serviços que vende, ou importe a lista em CSV.</p>
            @if (gerir)
            {
                <div class="d-flex justify-content-center gap-2">
                    <a class="btn btn-outline-primary" asp-page="Importar">Importar CSV</a>
                    <a class="btn btn-primary" asp-page="Editar">Novo artigo</a>
                </div>
            }
        }
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th class="d-none d-md-table-cell">Tipo</th>
                    <th>Unidade</th>
                    <th class="num">Preço</th>
                    <th class="num">IVA</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Resultado.Itens)
                {
                    <tr>
                        <td class="tabular fw-semibold text-nowrap">
                            @if (gerir) { <a class="text-decoration-none" asp-page="Editar" asp-route-id="@a.Id">@a.Codigo</a> } else { @a.Codigo }
                        </td>
                        <td>
                            @a.Descricao
                            @if (!a.Activo) { <span class="estado estado-inactivo ms-1">Inactivo</span> }
                        </td>
                        <td class="d-none d-md-table-cell">@(a.Tipo == TipoArtigo.Produto ? "Produto" : "Serviço")</td>
                        <td>@a.Unidade</td>
                        <td class="num">@Formato.Moeda(a.Preco)</td>
                        <td class="num">
                            @if (Model.TaxasVigentes.TryGetValue(a.CodigoTaxaIva, out var pct))
                            {
                                <span title="@a.CodigoTaxaIva">@Formato.Percentagem(pct)</span>
                            }
                            else
                            {
                                <span class="text-danger small" title="Esta taxa não está em vigor: o artigo não pode ser facturado até mudar a taxa">@a.CodigoTaxaIva fora de vigor</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacao" model="Model.Paginacao" />
}
