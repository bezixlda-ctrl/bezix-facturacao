@page
@model Bezix.Facturacao.Web.Pages.Administracao.Perfis.IndexModel
@{
    ViewData["Title"] = "Perfis e permissões";
}
<div class="cabecalho-pagina">
    <div>
        <h1>Perfis e permissões</h1>
        <p>Um perfil é um conjunto de permissões. Ajuste os perfis existentes ou crie novos sem mexer no sistema.</p>
    </div>
    <a class="btn btn-primary" asp-page="Editar"><i class="ph ph-plus me-1"></i>Criar perfil</a>
</div>

<section class="painel">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Perfil</th>
                    <th>Descrição</th>
                    <th class="num">Permissões</th>
                    <th class="num">Desconto sem aprovação</th>
                    <th class="num">Utilizadores</th>
                    <th><span class="visually-hidden">Acções</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Lista)
                {
                    <tr>
                        <td class="fw-semibold text-nowrap">@p.Nome @if (p.Sistema) { <i class="ph ph-lock-simple text-body-secondary small" title="Perfil do sistema"></i> }</td>
                        <td class="text-body-secondary small">@p.Descricao</td>
                        <td class="num">@p.Permissoes de @Permissoes.Todas.Count</td>
                        <td class="num">@(p.DescontoMaximoPct is { } d ? Formato.Percentagem(d) : "Sem limite")</td>
                        <td class="num">@p.Utilizadores</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-page="Editar" asp-route-id="@p.Id">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
