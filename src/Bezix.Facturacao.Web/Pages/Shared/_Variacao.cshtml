@model Bezix.Facturacao.Application.Painel.Indicador
@if (Model.Variacao is { } v)
{
    <span class="variacao @(v >= 0 ? "sobe" : "desce")">
        <i class="ph @(v >= 0 ? "ph-trend-up" : "ph-trend-down")"></i>@Formato.Percentagem(Math.Abs(v))
        <span class="text-body-secondary fw-normal">vs. mês anterior</span>
    </span>
}
else
{
    <span class="variacao text-body-secondary fw-normal">sem comparação com o mês anterior</span>
}
