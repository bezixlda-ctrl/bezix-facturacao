@inject Microsoft.Extensions.Options.IOptions<Bezix.Facturacao.Application.Abstracoes.OpcoesCertificacao> Certificacao
@inject Bezix.Facturacao.Application.Configuracao.ServicoEmpresa Empresas
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var empresa = await Empresas.ObterAsync();
    var tokenHtmx = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="pt" style="--bz-primaria: @empresa.CorPrimaria">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(Certificacao.Value.AmbienteTeste ? "[TESTE] " : "")@(ViewData["Title"] is string t ? $"{t} · " : "")@empresa.Nome</title>
    <script>
        // Aplica o tema antes de desenhar a página, para não piscar.
        (function () {
            var escolha = null;
            try { escolha = localStorage.getItem("bz-tema"); } catch (e) { }
            if (escolha !== "light" && escolha !== "dark") escolha = "auto";
            var tema = escolha === "auto" ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : escolha;
            document.documentElement.setAttribute("data-bs-theme", tema);
            document.documentElement.setAttribute("data-tema-escolha", escolha);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/phosphor/regular/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/phosphor/fill/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="~/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
</head>
<body hx-headers='{"RequestVerificationToken": "@tokenHtmx"}'>
    @if (Certificacao.Value.AmbienteTeste)
    {
        <div class="faixa-teste" role="status"><strong>AMBIENTE DE TESTE</strong> · sem valor fiscal. Documentos emitidos aqui não são válidos.</div>
    }
    <a class="visually-hidden-focusable position-absolute m-2 btn btn-primary" href="#conteudo">Saltar para o conteúdo</a>
    <div class="app">
        <aside class="app-menu offcanvas-lg offcanvas-start" tabindex="-1" id="menuLateral" aria-label="Menu principal">
            <a class="app-marca" asp-page="/Index">
                @if (empresa.LogoPath is not null)
                {
                    <img src="@Url.Content("~/marca/logotipo")?v=@empresa.UpdatedAt?.Ticks" alt="@empresa.Nome" />
                }
                else
                {
                    <span class="app-marca-sigla" aria-hidden="true">@(empresa.Nome.Length > 0 ? empresa.Nome[0] : 'B')</span>
                    <span>@empresa.Nome</span>
                }
            </a>
            <partial name="_Menu" />
        </aside>

        <div class="app-principal">
            <header class="app-topo">
                <button class="btn-icone d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menu">
                    <i class="ph ph-list"></i>
                </button>
                @if (User.TemAlguma(Permissoes.Clientes.Ver, Permissoes.Artigos.Ver))
                {
                    <div class="pesquisa-global" role="search">
                        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                        <label class="visually-hidden" for="pesquisaGlobal">Pesquisar clientes e artigos</label>
                        <input class="form-control" type="search" id="pesquisaGlobal" name="q" placeholder="Pesquisar cliente, NUIT, telefone, artigo" autocomplete="off"
                               hx-get="@Url.Content("~/Pesquisa")" hx-trigger="input changed delay:250ms, search" hx-target="#resultadosPesquisa" />
                        <kbd class="d-none d-md-inline">Ctrl K</kbd>
                        <div id="resultadosPesquisa" class="pesquisa-resultados"></div>
                    </div>
                }
                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (User.TemAlguma(Permissoes.Documentos.Rascunho, Permissoes.Documentos.EmitirFactura, Permissoes.Documentos.EmitirFacturaRecibo, Permissoes.Recibos.Registar, Permissoes.Clientes.Gerir))
                    {
                        <div class="dropdown">
                            <button class="btn btn-primary d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ph ph-plus"></i><span class="d-none d-md-inline">Novo</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.TemAlguma(Permissoes.Documentos.Rascunho, Permissoes.Documentos.EmitirFactura))
                                {
                                    <li><a class="dropdown-item" asp-page="/Documentos/Editar" asp-route-tipo="FT"><i class="ph ph-file-text me-2"></i>Nova factura</a></li>
                                }
                                @if (User.TemAlguma(Permissoes.Documentos.Rascunho, Permissoes.Documentos.EmitirFacturaRecibo))
                                {
                                    <li><a class="dropdown-item" asp-page="/Documentos/Editar" asp-route-tipo="FR"><i class="ph ph-receipt me-2"></i>Nova factura-recibo</a></li>
                                }
                                @if (User.TemPermissao(Permissoes.Recibos.Registar))
                                {
                                    <li><a class="dropdown-item" asp-page="/Recibos/Novo"><i class="ph ph-receipt me-2"></i>Novo recibo</a></li>
                                }
                                @if (User.TemPermissao(Permissoes.Clientes.Gerir))
                                {
                                    <li><a class="dropdown-item" asp-page="/Clientes/Editar"><i class="ph ph-user-plus me-2"></i>Novo cliente</a></li>
                                }
                            </ul>
                        </div>
                    }
                    <div class="dropdown d-none d-sm-block">
                        <button class="btn-icone" type="button" id="botaoTema" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Aspecto: claro, escuro ou automático" title="Aspecto">
                            <i class="ph ph-circle-half" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end menu-tema" role="menu" aria-labelledby="botaoTema">
                            <li><button class="dropdown-item" type="button" role="menuitemradio" data-tema="light"><i class="ph ph-sun" aria-hidden="true"></i>Claro</button></li>
                            <li><button class="dropdown-item" type="button" role="menuitemradio" data-tema="dark"><i class="ph ph-moon" aria-hidden="true"></i>Escuro</button></li>
                            <li><button class="dropdown-item" type="button" role="menuitemradio" data-tema="auto"><i class="ph ph-desktop" aria-hidden="true"></i>Automático (sistema)</button></li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="btn-icone w-auto px-2 gap-2 d-inline-flex" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="ph ph-user-circle" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline fw-semibold">@User.NomeVisivel()</span>
                            <span class="visually-hidden d-sm-none">Conta de @User.NomeVisivel()</span>
                            <i class="ph ph-caret-down small" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text small text-body-secondary">@User.Identity?.Name</span></li>
                            <li><a class="dropdown-item" asp-page="/Conta/Seguranca"><i class="ph ph-user-gear me-2"></i>A minha conta</a></li>
                            <li class="d-sm-none"><hr class="dropdown-divider" /></li>
                            <li class="d-sm-none"><span class="dropdown-item-text small text-body-secondary">Aspecto</span></li>
                            <li class="d-sm-none menu-tema"><button class="dropdown-item" type="button" role="menuitemradio" data-tema="light"><i class="ph ph-sun" aria-hidden="true"></i>Claro</button></li>
                            <li class="d-sm-none menu-tema"><button class="dropdown-item" type="button" role="menuitemradio" data-tema="dark"><i class="ph ph-moon" aria-hidden="true"></i>Escuro</button></li>
                            <li class="d-sm-none menu-tema"><button class="dropdown-item" type="button" role="menuitemradio" data-tema="auto"><i class="ph ph-desktop" aria-hidden="true"></i>Automático</button></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Conta/Sair">
                                    <button class="dropdown-item" type="submit"><i class="ph ph-sign-out me-2"></i>Sair</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-conteudo" id="conteudo">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_Mensagens" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
