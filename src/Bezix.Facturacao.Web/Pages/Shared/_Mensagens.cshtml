@{
    var sucesso = TempData[PaginaBase.ChaveSucesso] as string;
    var erro = TempData[PaginaBase.ChaveErro] as string;
}
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="mensagens" aria-live="polite">
    @if (sucesso is not null)
    {
        <div class="toast align-items-center border-0 text-bg-success" role="status" data-bs-delay="4000">
            <div class="d-flex">
                <div class="toast-body"><i class="ph ph-check-circle me-2"></i>@sucesso</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
            </div>
        </div>
    }
    @if (erro is not null)
    {
        <div class="toast align-items-center border-0 text-bg-danger" role="alert" data-bs-autohide="false">
            <div class="d-flex">
                <div class="toast-body"><i class="ph ph-warning me-2"></i>@erro</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Fechar"></button>
            </div>
        </div>
    }
</div>
