@page "{codigo}"
@model Bezix.Facturacao.Web.Pages.Comunicacao.Modelos.EditarModel
@using Bezix.Facturacao.Application.Comunicacao
@{
    ViewData["Title"] = Model.Modelo.Nome;
}
<div class="cabecalho-pagina">
    <div>
        <a asp-page="Index" class="small text-decoration-none"><i class="ph ph-arrow-left"></i> Modelos de email</a>
        <h1 class="mt-1">@Model.Modelo.Nome</h1>
        <p>Escreva texto simples; parágrafos separados por uma linha em branco. Os links começados por https:// ficam clicáveis.</p>
    </div>
</div>

<partial name="_ResumoErros" />

<div class="row g-4">
    <div class="col-xl-7">
        <form method="post" class="painel" id="formModelo">
            <div class="painel-corpo row g-3">
                <div class="col-12">
                    <label class="form-label" asp-for="Assunto">Assunto</label>
                    <input class="form-control" asp-for="Assunto" maxlength="300" required />
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Corpo">Texto do email</label>
                    <textarea class="form-control font-monospace small" asp-for="Corpo" rows="16" required></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Cc">Enviar sempre cópia para <span class="text-body-secondary">(opcional, separe por vírgulas)</span></label>
                    <input class="form-control" asp-for="Cc" maxlength="500" placeholder="contabilidade@@empresa.co.mz" />
                </div>
                <div class="col-12 d-flex flex-wrap gap-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="AnexarPdf" />
                        <label class="form-check-label" asp-for="AnexarPdf">Anexar o PDF do documento</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="Activo" />
                        <label class="form-check-label" asp-for="Activo">Activo <span class="text-body-secondary small">(inactivo usa o texto original)</span></label>
                    </div>
                </div>
            </div>
            <div class="painel-rodape d-flex flex-wrap gap-2 justify-content-between">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary" hx-post="@Url.Page(null, "Previsualizar", new { codigo = Model.Codigo })"
                            hx-include="#formModelo" hx-target="#previsao"><i class="ph ph-eye me-1"></i>Pré-visualizar</button>
                    <button type="submit" class="btn btn-outline-secondary" asp-page-handler="Teste"><i class="ph ph-paper-plane-tilt me-1"></i>Enviar teste para mim</button>
                </div>
                <button type="submit" class="btn btn-primary"><i class="ph ph-check me-1"></i>Guardar modelo</button>
            </div>
        </form>
        @if (Model.TemOriginal)
        {
            <form method="post" asp-page-handler="Repor" asp-route-codigo="@Model.Codigo" class="mt-2 text-end"
                  data-confirmar="Repor o texto original deste modelo? O texto actual perde-se.">
                <button type="submit" class="btn btn-link btn-sm text-body-secondary">Repor texto original</button>
            </form>
        }
    </div>
    <div class="col-xl-5">
        <section class="painel mb-4">
            <div class="painel-cabecalho"><h2>Pré-visualização</h2></div>
            <div class="painel-corpo" id="previsao">
                <p class="small text-body-secondary mb-0">Carregue em <strong>Pré-visualizar</strong> para ver o email com os dados do último documento emitido.</p>
            </div>
        </section>
        <section class="painel">
            <div class="painel-cabecalho"><h2>Variáveis</h2></div>
            <ul class="list-unstyled painel-corpo mb-0 small variaveis">
                @foreach (var v in ModelosPadrao.Variaveis)
                {
                    <li><button type="button" class="btn btn-link btn-sm p-0 font-monospace" data-inserir="@v.Nome" title="Inserir no texto">@v.Nome</button> <span class="text-body-secondary">@v.Descricao</span></li>
                }
            </ul>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Insere a variável na posição do cursor do último campo usado (assunto ou texto).
        (() => {
            let campo = document.getElementById('Corpo');
            for (const id of ['Assunto', 'Corpo']) document.getElementById(id).addEventListener('focus', e => campo = e.target);
            document.querySelectorAll('[data-inserir]').forEach(b => b.addEventListener('click', () => {
                const i = campo.selectionStart ?? campo.value.length, f = campo.selectionEnd ?? i;
                campo.setRangeText(b.dataset.inserir, i, f, 'end');
                campo.focus();
            }));
        })();
    </script>
}
