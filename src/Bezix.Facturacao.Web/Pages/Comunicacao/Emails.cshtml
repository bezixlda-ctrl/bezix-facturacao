@page
@model Bezix.Facturacao.Web.Pages.Comunicacao.EmailsModel
@using Bezix.Facturacao.Domain.Comunicacao
@{
    ViewData["Title"] = "Emails enviados";
    string Filtro(EstadoEmail? e) => Model.Estado == e ? "btn-primary" : "btn-outline-secondary";
}
<div class="cabecalho-pagina">
    <div>
        <h1>Emails enviados</h1>
        <p>Tudo o que o sistema enviou a clientes. Os que falham são repetidos automaticamente (1, 5 e 30 minutos, 2 e 12 horas); pode reenviar à mão.</p>
    </div>
    @if (User.TemPermissao(Permissoes.Comunicacao.GerirModelos))
    {
        <a class="btn btn-outline-secondary" asp-page="Modelos/Index"><i class="bi bi-pencil-square me-1"></i>Modelos de email</a>
    }
</div>

<section class="painel">
    <div class="d-flex flex-wrap gap-2 p-3 border-bottom">
        <a class="btn btn-sm @Filtro(null)" asp-page="Emails">Todos</a>
        <a class="btn btn-sm @Filtro(EstadoEmail.Enviado)" asp-page="Emails" asp-route-estado="Enviado">Enviados</a>
        <a class="btn btn-sm @Filtro(EstadoEmail.Pendente)" asp-page="Emails" asp-route-estado="Pendente">Na fila</a>
        <a class="btn btn-sm @Filtro(EstadoEmail.Falhou)" asp-page="Emails" asp-route-estado="Falhou">Falhados</a>
    </div>
    @if (Model.Resultado.Total == 0)
    {
        <div class="vazio"><i class="bi bi-envelope"></i><p class="mb-0">Sem emails @(Model.Estado is null ? "" : "neste estado").</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Criado</th><th>Para</th><th>Assunto</th><th>Estado</th><th><span class="visually-hidden">Acções</span></th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Resultado.Itens)
                    {
                        <tr>
                            <td class="tabular text-nowrap">@Formato.DataHora(e.CriadoEm)</td>
                            <td class="text-break">@e.Para</td>
                            <td>
                                @if (e.DocumentoId is { } d) { <a asp-page="/Documentos/Detalhe" asp-route-id="@d" class="text-reset">@e.Assunto</a> }
                                else if (e.ClienteId is { } c) { <a asp-page="/Clientes/Detalhe" asp-route-id="@c" class="text-reset">@e.Assunto</a> }
                                else { @e.Assunto }
                                @if (e.Erro is not null && e.Estado != EstadoEmail.Enviado) { <div class="small text-danger">@e.Erro</div> }
                            </td>
                            <td class="text-nowrap">
                                @switch (e.Estado)
                                {
                                    case EstadoEmail.Enviado: <span class="estado estado-pago">Enviado @(e.EnviadoEm is { } t ? Formato.DataHora(t)[11..] : "")</span> break;
                                    case EstadoEmail.Pendente: <span class="estado estado-rascunho">Na fila@(e.Tentativas > 0 ? $" · {e.Tentativas} tentativas" : "")</span> break;
                                    default: <span class="estado estado-vencido">Falhou</span> break;
                                }
                            </td>
                            <td class="text-end">
                                @if (e.Estado != EstadoEmail.Enviado)
                                {
                                    <form method="post" asp-page-handler="Reenviar" asp-route-id="@e.Id" asp-route-estado="@Model.Estado" class="d-inline">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-arrow-clockwise me-1"></i>Reenviar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Paginacao" model="Model.Paginacao" />
    }
</section>
