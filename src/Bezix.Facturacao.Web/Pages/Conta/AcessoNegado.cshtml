@page
@{
    ViewData["Title"] = "Sem acesso";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LayoutAcesso";
}
<div class="vazio">
    <i class="ph ph-lock-key"></i>
    <h1 class="h2">O seu perfil não dá acesso a esta página</h1>
    <p>Se precisa desta função, peça a um administrador para ajustar o seu perfil.</p>
    <a class="btn btn-primary" href="~/">Voltar ao painel</a>
</div>
