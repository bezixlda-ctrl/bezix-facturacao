@page
@model Bezix.Facturacao.Web.Pages.Conta.Entrar2FAModel
@{
    ViewData["Title"] = "Verificação em dois passos";
    Layout = "_LayoutAcesso";
}
<h1 class="h2 mb-1">Verificação em dois passos</h1>
<p class="text-body-secondary mb-4">Abra a aplicação de autenticação no telemóvel e escreva o código de 6 algarismos.</p>

<partial name="_ResumoErros" />

<form method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Lembrar" />
    <div class="mb-3">
        <label asp-for="Codigo" class="form-label">Código</label>
        <input asp-for="Codigo" class="form-control form-control-lg tabular" inputmode="numeric" autocomplete="one-time-code" autofocus />
    </div>
    <div class="form-check mb-2">
        <input asp-for="LembrarComputador" class="form-check-input" />
        <label asp-for="LembrarComputador" class="form-check-label">Não pedir de novo neste computador</label>
    </div>
    <div class="form-check mb-4">
        <input asp-for="UsarCodigoRecuperacao" class="form-check-input" />
        <label asp-for="UsarCodigoRecuperacao" class="form-check-label">Perdi o telemóvel: usar um código de recuperação</label>
    </div>
    <button type="submit" class="btn btn-primary w-100">Confirmar</button>
</form>
<p class="small mt-4 mb-0"><a asp-page="Entrar">Voltar ao início de sessão</a></p>
