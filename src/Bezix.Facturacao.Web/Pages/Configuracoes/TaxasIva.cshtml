@page
@model Bezix.Facturacao.Web.Pages.Configuracoes.TaxasIvaModel
@{
    ViewData["Title"] = "Taxas de IVA e isenções";
}
<div class="cabecalho-pagina">
    <div>
        <a asp-page="Index" class="small text-decoration-none"><i class="ph ph-arrow-left"></i> Configurações</a>
        <h1 class="mt-1">Taxas de IVA e isenções</h1>
        <p>Uma taxa nunca muda de valor. Quando a lei muda, feche a taxa actual numa data e crie a nova a partir do dia seguinte. Lembre-se de abrir também novas séries.</p>
    </div>
</div>

<partial name="_ResumoErros" />

<section class="painel mb-4">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th class="num">Taxa</th>
                    <th>Motivo de isenção</th>
                    <th>Vigência</th>
                    <th>Estado</th>
                    @if (Model.PodeGerir) { <th><span class="visually-hidden">Acções</span></th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Taxas)
                {
                    var vigente = t.EstaVigente(Model.Hoje);
                    <tr>
                        <td class="fw-bold">@t.Codigo</td>
                        <td>@t.Descricao</td>
                        <td class="num">@Formato.Percentagem(t.Percentagem)</td>
                        <td class="small">@t.MotivoIsencao</td>
                        <td class="tabular text-nowrap">@Formato.Data(t.VigenteDesde) – @(t.VigenteAte is { } fim ? Formato.Data(fim) : "sem fim")</td>
                        <td><span class="estado @(vigente ? "estado-activo" : "estado-inactivo")">@(vigente ? "Em vigor" : "Fora de vigor")</span></td>
                        @if (Model.PodeGerir)
                        {
                            <td class="text-end">
                                @if (t.VigenteAte is null)
                                {
                                    <form method="post" asp-page-handler="Fechar" asp-route-id="@t.Id" class="d-inline-flex gap-1 align-items-center"
                                          data-confirmar="Fechar a taxa @t.Codigo? Depois da data indicada não pode ser usada em documentos novos.">
                                        <label class="visually-hidden" for="fim-@t.Id">Último dia de vigência</label>
                                        <input type="date" class="form-control form-control-sm" id="fim-@t.Id" name="vigenteAte" value="@Model.Hoje.ToString("yyyy-MM-dd")" required />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary text-nowrap">Fechar taxa</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (Model.PodeGerir)
{
    <form method="post" asp-page-handler="Criar" class="painel" style="max-width: 820px" novalidate>
        <div class="painel-cabecalho"><h2>Nova taxa ou isenção</h2></div>
        <div class="painel-corpo row g-3">
            <div class="col-sm-3">
                <label class="form-label" asp-for="Nova.Codigo">Código</label>
                <input class="form-control text-uppercase" asp-for="Nova.Codigo" maxlength="20" placeholder="NOR" />
            </div>
            <div class="col-sm-6">
                <label class="form-label" asp-for="Nova.Descricao">Descrição</label>
                <input class="form-control" asp-for="Nova.Descricao" placeholder="Taxa normal" />
            </div>
            <div class="col-sm-3">
                <label class="form-label" asp-for="Nova.Percentagem">Taxa</label>
                <div class="input-group">
                    <input class="form-control tabular text-end" asp-for="Nova.Percentagem" type="text" inputmode="decimal" value="@Formato.Numero(Model.Nova.Percentagem)" />
                    <span class="input-group-text">%</span>
                </div>
            </div>
            <div class="col-sm-9">
                <label class="form-label" asp-for="Nova.MotivoIsencao">Motivo de isenção <span class="text-body-secondary">(obrigatório se a taxa for 0%)</span></label>
                <input class="form-control" asp-for="Nova.MotivoIsencao" placeholder="Menção legal impressa no documento" />
            </div>
            <div class="col-sm-3">
                <label class="form-label" asp-for="Nova.VigenteDesde">Em vigor desde</label>
                <input class="form-control" asp-for="Nova.VigenteDesde" type="date" />
            </div>
        </div>
        <div class="painel-corpo border-top d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">Criar taxa</button>
        </div>
    </form>
}
