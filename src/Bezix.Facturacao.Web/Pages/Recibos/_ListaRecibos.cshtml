@model Bezix.Facturacao.Web.Pages.Recibos.IndexModel
@using Bezix.Facturacao.Web.Pages.Documentos
@if (Model.Resultado.Total == 0)
{
    <div class="vazio">
        <i class="bi bi-receipt"></i>
        <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Q) && Model.De is null && Model.Ate is null ? "Ainda não há recibos." : "Nenhum recibo corresponde à pesquisa.")</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Recibo</th><th>Cliente</th><th>Data</th><th class="num">Recebido</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Resultado.Itens)
                {
                    var (classe, texto) = Vista.Estado(r.Estado);
                    <tr>
                        <td><a asp-page="/Documentos/Detalhe" asp-route-id="@r.Id" class="doc-num text-decoration-none"><span class="tipo">RC</span> @r.NumeroFormatado?[3..]</a></td>
                        <td><a class="text-reset text-decoration-none" asp-page="/ContaCorrente/Cliente" asp-route-id="@r.ClienteId">@r.ClienteNome</a></td>
                        <td class="tabular">@Formato.Data(r.Data)</td>
                        <td class="num">@Formato.Moeda(r.Total)</td>
                        <td><span class="estado @classe">@texto</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Paginacao" model="Model.Paginacao" />
}
