@page
@model Bezix.Facturacao.Web.Pages.Recibos.NovoModel
@using Bezix.Facturacao.Domain.Documentos
@{
    ViewData["Title"] = "Registar recibo";
}
<div class="cabecalho-pagina">
    <div>
        <a asp-page="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Recibos</a>
        <h1 class="mt-1">Registar recibo</h1>
        <p>Valores em meticais. Reparta o valor recebido pelas facturas que o cliente está a pagar; o que sobrar fica como adiantamento.</p>
    </div>
</div>

<form method="post" id="formRecibo" novalidate>
    <partial name="_ResumoErros" />
    <input type="hidden" asp-for="ClienteId" id="clienteId" />

    <div class="row g-4">
        <div class="col-xl-4">
            <section class="painel">
                <div class="painel-corpo row g-3">
                    <div class="col-12">
                        <span class="form-label d-block" id="rotuloCliente">Cliente</span>
                        <div id="clienteEscolhido" class="@(Model.ClienteId > 0 ? "" : "d-none")">
                            <div class="form-control d-flex justify-content-between align-items-center" aria-labelledby="rotuloCliente">
                                <strong id="clienteNome">@Model.NomeCliente</strong>
                                <button type="button" class="btn btn-sm btn-link p-0" id="trocarCliente">Trocar</button>
                            </div>
                        </div>
                        <div id="pesquisaClienteBloco" class="position-relative @(Model.ClienteId > 0 ? "d-none" : "")">
                            <input class="form-control" type="search" id="pesquisaCliente" name="q" placeholder="Nome, NUIT ou telefone" autocomplete="off" aria-labelledby="rotuloCliente"
                                   hx-get="@Url.Page("/Documentos/Editar", "Clientes")" hx-trigger="input changed delay:250ms" hx-target="#resultadosCliente" hx-include="this" />
                            <div id="resultadosCliente" class="pesquisa-resultados"></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Data">Data</label>
                        <input class="form-control" asp-for="Data" type="date" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Valor">Valor recebido</label>
                        <div class="input-group">
                            <input class="form-control tabular text-end" asp-for="Valor" type="text" inputmode="decimal" id="valorRecebido"
                                   value="@(Model.Valor == 0 ? "" : Formato.Numero(Model.Valor))" />
                            <span class="input-group-text">MT</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Metodo">Método</label>
                        <select class="form-select" asp-for="Metodo">
                            @foreach (var m in Enum.GetValues<MetodoPagamento>())
                            {
                                <option value="@m">@MetodoPagamentoInfo.Nome(m)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Referencia">Referência</label>
                        <input class="form-control" asp-for="Referencia" maxlength="100" placeholder="N.º transferência, M-Pesa…" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Observacoes">Observações <span class="text-body-secondary">(opcional)</span></label>
                        <textarea class="form-control" asp-for="Observacoes" rows="2" maxlength="2000"></textarea>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-8">
            <section class="painel" id="abertos" hx-get="@Url.Page("/Recibos/Novo", "Abertos")" hx-trigger="clienteEscolhido from:body" hx-include="#clienteId">
                <partial name="_Abertos" model="Model" />
            </section>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/recibo.js" asp-append-version="true"></script>
}
