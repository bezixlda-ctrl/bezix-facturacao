@page
@model Bezix.Facturacao.Web.Pages.Recibos.IndexModel
@{
    ViewData["Title"] = "Recibos";
}
<div class="cabecalho-pagina">
    <div>
        <h1>Recibos</h1>
        <p>Pagamentos recebidos, em meticais. Cada recibo pode pagar várias facturas; o que sobra fica como adiantamento do cliente.</p>
    </div>
    @if (User.TemPermissao(Permissoes.Recibos.Registar))
    {
        <a class="btn btn-primary" asp-page="Novo"><i class="ph ph-hand-coins me-1"></i>Registar recibo</a>
    }
</div>

<section class="painel">
    <form method="get" class="d-flex flex-wrap gap-2 p-3 border-bottom" role="search"
          hx-get="@Url.Page("/Recibos/Index")" hx-target="#listaRecibos" hx-push-url="true"
          hx-trigger="input changed delay:300ms from:#Q, change from:input[type=date], submit">
        <div class="flex-grow-1" style="min-width: 200px">
            <label class="visually-hidden" for="Q">Pesquisar recibos</label>
            <input class="form-control" type="search" id="Q" name="Q" value="@Model.Q" placeholder="N.º do recibo, cliente ou NUIT" autocomplete="off" />
        </div>
        <div class="filtro-datas">
            <label class="small text-body-secondary" for="De">De</label>
            <input class="form-control" type="date" id="De" name="De" value="@Model.De?.ToString("yyyy-MM-dd")" />
            <label class="small text-body-secondary" for="Ate">a</label>
            <input class="form-control" type="date" id="Ate" name="Ate" value="@Model.Ate?.ToString("yyyy-MM-dd")" />
        </div>
    </form>
    <div id="listaRecibos">
        <partial name="_ListaRecibos" model="Model" />
    </div>
</section>
