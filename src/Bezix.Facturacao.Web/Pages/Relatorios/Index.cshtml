@page
@model Bezix.Facturacao.Web.Pages.Relatorios.IndexModel
@{
    ViewData["Title"] = "Relatórios";
    var u = User;
}
<div class="cabecalho-pagina">
    <div>
        <h1>Relatórios</h1>
        <p>Vendas e obrigações fiscais, em meticais, a partir dos documentos emitidos. Todos exportam para Excel (CSV).</p>
    </div>
</div>

<div class="row g-4">
    @if (u.TemPermissao(Permissoes.Relatorios.Vendas))
    {
        <div class="col-md-6 col-xl-4">
            <a asp-page="Vendas" class="painel cartao-relatorio">
                <i class="ph ph-chart-line-up"></i>
                <h2>Vendas</h2>
                <p>Por cliente, artigo, mês ou tipo de documento, num período à escolha.</p>
            </a>
        </div>
    }
    @if (u.TemPermissao(Permissoes.Relatorios.Fiscal))
    {
        <div class="col-md-6 col-xl-4">
            <a asp-page="Iva" class="painel cartao-relatorio">
                <i class="ph ph-percent"></i>
                <h2>Mapa de IVA e anulados</h2>
                <p>IVA liquidado por taxa (facturado menos creditado) e documentos anulados no período.</p>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a asp-page="ExportacaoAT" class="painel cartao-relatorio">
                <i class="ph ph-file-zip"></i>
                <h2>Exportação AT</h2>
                <p>Ficheiro mensal dos documentos fiscais, histórico de submissões e verificação de integridade.</p>
            </a>
        </div>
    }
    <div class="col-md-6 col-xl-4">
        <a asp-page="/ContaCorrente/Antiguidade" class="painel cartao-relatorio">
            <i class="ph ph-hourglass-medium"></i>
            <h2>Antiguidade de saldos</h2>
            <p>O que cada cliente deve, por escalão de atraso.</p>
        </a>
    </div>
</div>
