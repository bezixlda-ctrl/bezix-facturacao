@page
@model Bezix.Facturacao.Web.Pages.Relatorios.VendasModel
@using Bezix.Facturacao.Application.Relatorios
@{
    ViewData["Title"] = "Vendas";
    var artigo = Model.Agrupar == AgruparVendas.Artigo;
}
<div class="cabecalho-pagina">
    <div>
        <a asp-page="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Relatórios</a>
        <h1 class="mt-1">Vendas</h1>
        <p>Facturas, facturas-recibo, facturas globais e notas de débito emitidas, menos as notas de crédito. Os anulados não contam. Valores em meticais, sem IVA na coluna Base.@(Model.SoProprios ? " Só os documentos de que é responsável." : "")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page-handler="Csv" asp-route-de="@Model.Inicio.ToString("yyyy-MM-dd")" asp-route-ate="@Model.Fim.ToString("yyyy-MM-dd")" asp-route-agrupar="@Model.Agrupar"><i class="bi bi-filetype-csv me-1"></i>Excel (CSV)</a>
</div>

<section class="painel">
    <form method="get" class="d-flex flex-wrap justify-content-between align-items-end gap-3 p-3 border-bottom">
        <partial name="_Periodo" model="(Model.Inicio, Model.Fim)" />
        <div>
            <label class="form-label small mb-1" for="Agrupar">Agrupar por</label>
            <select class="form-select" id="Agrupar" name="Agrupar" onchange="this.form.submit()">
                <option value="Cliente" selected="@(Model.Agrupar == AgruparVendas.Cliente)">Cliente</option>
                <option value="Artigo" selected="@(Model.Agrupar == AgruparVendas.Artigo)">Artigo</option>
                <option value="Mes" selected="@(Model.Agrupar == AgruparVendas.Mes)">Mês</option>
                <option value="Tipo" selected="@(Model.Agrupar == AgruparVendas.Tipo)">Tipo de documento</option>
            </select>
        </div>
    </form>
    @if (Model.Linhas.Count == 0)
    {
        <div class="vazio"><i class="bi bi-bar-chart-line"></i><p class="mb-0">Sem vendas neste período.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@Model.Coluna</th><th>Descrição</th><th class="num">Docs</th>
                        @if (artigo) { <th class="num">Quantidade</th> }
                        <th class="num">Base</th><th class="num">IVA</th><th class="num">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Linhas)
                    {
                        <tr>
                            <td class="tabular">@l.Chave</td><td>@l.Descricao</td><td class="num">@l.Documentos</td>
                            @if (artigo) { <td class="num">@l.Quantidade.ToString("0.##", Formato.Cultura)</td> }
                            <td class="num">@Formato.Numero(l.Base)</td><td class="num">@Formato.Numero(l.Iva)</td><td class="num">@Formato.Numero(l.Total)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="@(artigo ? 4 : 3)">Total</td>
                        <td class="num">@Formato.Numero(Model.Linhas.Sum(l => l.Base))</td>
                        <td class="num">@Formato.Numero(Model.Linhas.Sum(l => l.Iva))</td>
                        <td class="num">@Formato.Numero(Model.Linhas.Sum(l => l.Total))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @if (artigo)
        {
            <p class="small text-body-secondary p-3 mb-0">Por artigo, o desconto global de cada documento é repartido pelas linhas; o IVA é recalculado por linha e pode diferir em cêntimos do mapa de IVA.</p>
        }
    }
</section>
