@page
@model Bezix.Facturacao.Web.Pages.Clientes.IndexModel
@using Bezix.Facturacao.Application.Clientes
@{
    ViewData["Title"] = "Clientes";
    var gerir = User.TemPermissao(Permissoes.Clientes.Gerir);
}
<div class="cabecalho-pagina">
    <div>
        <h1>Clientes</h1>
        @if (Model.SoProprios)
        {
            <p>Mostra só os clientes de que é responsável.</p>
        }
    </div>
    @if (gerir)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-page="Importar"><i class="bi bi-upload me-1"></i>Importar CSV</a>
            <a class="btn btn-primary" asp-page="Editar"><i class="bi bi-person-plus me-1"></i>Novo cliente</a>
        </div>
    }
</div>

<section class="painel">
    <form method="get" class="d-flex flex-wrap gap-2 p-3 border-bottom" role="search"
          hx-get="@Url.Page("/Clientes/Index")" hx-target="#listaClientes" hx-push-url="true"
          hx-trigger="input changed delay:300ms from:#Q, change from:select, submit">
        <div class="flex-grow-1" style="min-width: 220px">
            <label class="visually-hidden" for="Q">Pesquisar clientes</label>
            <input class="form-control" type="search" id="Q" name="Q" value="@Model.Q" placeholder="Nome, NUIT, telefone, contacto ou email" autocomplete="off" />
        </div>
        @if (Model.Etiquetas.Count > 0)
        {
            <label class="visually-hidden" for="Etiqueta">Etiqueta</label>
            <select class="form-select w-auto" id="Etiqueta" name="Etiqueta">
                <option value="">Todas as etiquetas</option>
                @foreach (var e in Model.Etiquetas)
                {
                    <option value="@e" selected="@(e == Model.Etiqueta)">@e</option>
                }
            </select>
        }
        <label class="visually-hidden" for="Estado">Estado</label>
        <select class="form-select w-auto" id="Estado" name="Estado">
            <option value="@FiltroEstado.Activos" selected="@(Model.Estado == FiltroEstado.Activos)">Activos</option>
            <option value="@FiltroEstado.Inactivos" selected="@(Model.Estado == FiltroEstado.Inactivos)">Inactivos</option>
            <option value="@FiltroEstado.Todos" selected="@(Model.Estado == FiltroEstado.Todos)">Todos</option>
        </select>
        <noscript><button class="btn btn-outline-primary" type="submit">Pesquisar</button></noscript>
    </form>
    <div id="listaClientes">
        <partial name="_ListaClientes" model="Model" />
    </div>
</section>
