@page "{id:int?}"
@model Bezix.Facturacao.Web.Pages.Clientes.EditarModel
@using Bezix.Facturacao.Domain.Clientes
@{
    ViewData["Title"] = Model.Novo ? "Novo cliente" : Model.Dados.Nome;
}
<div class="cabecalho-pagina">
    <div>
        @if (Model.Novo)
        {
            <a asp-page="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Clientes</a>
        }
        else
        {
            <a asp-page="Detalhe" asp-route-id="@Model.Id" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> @Model.Dados.Nome</a>
        }
        <h1 class="mt-1">@(Model.Novo ? "Novo cliente" : "Editar cliente")</h1>
    </div>
</div>

<form method="post" novalidate>
    <partial name="_ResumoErros" />

    @if (Model.Duplicados.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <div class="fw-bold mb-1"><i class="bi bi-people me-1"></i>Já existe @(Model.Duplicados.Count == 1 ? "outro cliente" : "outros clientes") com o NUIT @Model.Dados.Nuit:</div>
            <ul class="mb-2">
                @foreach (var d in Model.Duplicados)
                {
                    <li><a asp-page="Detalhe" asp-route-id="@d.Id" target="_blank">@d.Nome</a></li>
                }
            </ul>
            <p class="mb-2">Se é o mesmo cliente, use a ficha existente. Se é outro registo com o mesmo NUIT (por exemplo, uma filial), confirme abaixo.</p>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="AceitarNuitDuplicado" />
                <label class="form-check-label fw-semibold" asp-for="AceitarNuitDuplicado">Confirmo que é outro registo com o mesmo NUIT</label>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="painel mb-4">
                <div class="painel-cabecalho"><h2>Identificação</h2></div>
                <div class="painel-corpo row g-3">
                    <div class="col-12">
                        <span class="form-label d-block">Tipo</span>
                        <div class="btn-group" role="group" aria-label="Tipo de cliente">
                            <input type="radio" class="btn-check" asp-for="Dados.Tipo" value="@TipoCliente.Empresa" id="tipoEmpresa" />
                            <label class="btn btn-outline-primary" for="tipoEmpresa">Empresa</label>
                            <input type="radio" class="btn-check" asp-for="Dados.Tipo" value="@TipoCliente.Particular" id="tipoParticular" />
                            <label class="btn btn-outline-primary" for="tipoParticular">Particular</label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" asp-for="Dados.Nome">Nome</label>
                        <input class="form-control" asp-for="Dados.Nome" maxlength="200" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Dados.Nuit">NUIT</label>
                        <input class="form-control tabular" asp-for="Dados.Nuit" inputmode="numeric" maxlength="11" placeholder="9 algarismos" />
                        <div class="form-text">Obrigatório para facturar a empresas.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.Endereco">Endereço</label>
                        <input class="form-control" asp-for="Dados.Endereco" maxlength="300" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Dados.Cidade">Cidade</label>
                        <input class="form-control" asp-for="Dados.Cidade" maxlength="100" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="Dados.Contacto">Pessoa de contacto (Att.)</label>
                        <input class="form-control" asp-for="Dados.Contacto" maxlength="150" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Dados.Telefone">Telefone</label>
                        <input class="form-control tabular" asp-for="Dados.Telefone" type="tel" maxlength="50" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Dados.Celular">Celular</label>
                        <input class="form-control tabular" asp-for="Dados.Celular" type="tel" maxlength="50" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Dados.Email">Email</label>
                        <input class="form-control" asp-for="Dados.Email" type="email" maxlength="200" />
                    </div>
                </div>
            </section>

            <section class="painel">
                <div class="painel-cabecalho"><h2>Notas e etiquetas</h2></div>
                <div class="painel-corpo row g-3">
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.Etiquetas">Etiquetas</label>
                        <input class="form-control" asp-for="Dados.Etiquetas" placeholder="Ex.: governo, revenda, Matola" maxlength="500" />
                        <div class="form-text">Separadas por vírgulas. Servem para filtrar a lista de clientes.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.Notas">Notas internas</label>
                        <textarea class="form-control" asp-for="Dados.Notas" rows="3" maxlength="2000"></textarea>
                        <div class="form-text">Não aparecem nos documentos.</div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-xl-4">
            <section class="painel mb-4">
                <div class="painel-cabecalho"><h2>Condições</h2></div>
                <div class="painel-corpo row g-3">
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.PrazoPagamentoDias">Prazo de pagamento</label>
                        <div class="input-group">
                            <input class="form-control tabular" asp-for="Dados.PrazoPagamentoDias" type="number" min="0" max="365" placeholder="o da empresa" />
                            <span class="input-group-text">dias</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.LimiteCredito">Limite de crédito</label>
                        <div class="input-group">
                            <input class="form-control tabular text-end" asp-for="Dados.LimiteCredito" type="text" inputmode="decimal"
                                   value="@(Model.Dados.LimiteCredito is { } l ? Formato.Numero(l) : "")" placeholder="sem limite" />
                            <span class="input-group-text">MT</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.DescontoPadraoPct">Desconto habitual</label>
                        <div class="input-group">
                            <input class="form-control tabular text-end" asp-for="Dados.DescontoPadraoPct" type="text" inputmode="decimal" value="@Formato.Numero(Model.Dados.DescontoPadraoPct)" />
                            <span class="input-group-text">%</span>
                        </div>
                        <div class="form-text">Proposto automaticamente nos documentos novos.</div>
                    </div>
                    @if (Model.PodeEscolherResponsavel)
                    {
                        <div class="col-12">
                            <label class="form-label" asp-for="Dados.ResponsavelId">Responsável</label>
                            <select class="form-select" asp-for="Dados.ResponsavelId">
                                <option value="">—</option>
                                @foreach (var u in Model.Responsaveis)
                                {
                                    <option value="@u.Id">@u.Nome</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </section>

            <section class="painel">
                <div class="painel-cabecalho"><h2>Envio de documentos</h2></div>
                <div class="painel-corpo row g-3">
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.EmailFacturacao">Email para facturas</label>
                        <input class="form-control" asp-for="Dados.EmailFacturacao" type="email" maxlength="200" placeholder="o email geral" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Dados.EmailCc">Em cópia</label>
                        <input class="form-control" asp-for="Dados.EmailCc" maxlength="500" placeholder="contabilidade@@empresa.co.mz" />
                        <div class="form-text">Vários emails separados por vírgulas.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="Dados.LembretesActivos" role="switch" />
                            <label class="form-check-label" asp-for="Dados.LembretesActivos">Enviar lembretes de pagamento</label>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary" href="@(Model.Novo ? Url.Page("Index") : Url.Page("Detalhe", new { id = Model.Id }))">Cancelar</a>
        <button type="submit" class="btn btn-primary">@(Model.Novo ? "Criar cliente" : "Guardar cliente")</button>
    </div>
</form>
